# Odice — complément .env pour la pile de STAGING.
#
# À concaténer au .env d'un clone de zammad-docker-compose dédié au staging
# (par exemple /opt/zammad-staging), puis à ajuster.
#
# Ne recopiez JAMAIS tel quel le .env de la production : les deux piles doivent
# différer sur le nom de projet, le domaine, les mots de passe et l'espace de
# noms Elasticsearch. Tout ce qui est identique est une occasion de confusion,
# et deux ou trois de ces valeurs partagées suffisent à faire écrire le staging
# dans les données de la production.

# --- Identité de l'environnement ---------------------------------------------
# Lue par restore-local.sh et les scripts de bascule AVANT toute opération
# destructrice. Sans elle, le rafraîchissement refuse de s'exécuter.
ODICE_ENVIRONMENT=staging

# Préfixe des conteneurs, des volumes et du réseau. C'est LA variable qui
# sépare physiquement les deux piles : à valeur identique, elles partageraient
# leurs volumes, donc leur base.
COMPOSE_PROJECT_NAME=zammad-staging

# --- Exposition ---------------------------------------------------------------
# Indirection délibérée : maintenance.sh vide cette variable pour retirer
# l'application des vhosts de nginx-proxy. Voir docker-compose.nginx-proxy.yml.
ZAMMAD_VIRTUAL_HOST=staging.support.odice.info
LETSENCRYPT_HOST=staging.support.odice.info
LETSENCRYPT_EMAIL=it@odice.info

NGINX_SERVER_NAME=staging.support.odice.info
# https et non http, derrière la terminaison TLS de nginx-proxy : sinon toutes
# les URL des courriels et des redirections partent en clair.
NGINX_SERVER_SCHEME=https
ZAMMAD_FQDN=staging.support.odice.info
ZAMMAD_HTTP_TYPE=https

# Publié sur la BOUCLE LOCALE seulement. Un « 8081 » nu écouterait sur 0.0.0.0
# et exposerait le staging à l'internet en contournant nginx-proxy — un
# pare-feu hôte n'y changerait rien, Docker insérant ses règles avant les
# siennes. Le nom de la variable vient de zammad-docker-compose, qui publie
# « ${NGINX_EXPOSE_PORT}:${NGINX_PORT} ».
NGINX_EXPOSE_PORT=127.0.0.1:8081
ODICE_HEALTH_URL=http://127.0.0.1:8081/api/v1/getting_started

# --- Neutralisation de la copie -----------------------------------------------
# Appliquées par odice:sandbox après chaque rafraîchissement.
ODICE_SANDBOX_FQDN=staging.support.odice.info
# https, PAS http : Session.secure_flag? lit ce réglage pour poser l'attribut
# Secure du cookie de session. Le forcer à http derrière du TLS produirait des
# liens en clair et un cookie sans Secure.
ODICE_SANDBOX_HTTP_TYPE=https
# Mot de passe appliqué aux comptes administrateurs de la copie, le SSO étant
# coupé. À choisir long, distinct de tout mot de passe de production, et SANS
# caractère « $ » (voir plus bas).
ODICE_SANDBOX_PASSWORD=

# --- Marque -------------------------------------------------------------------
# odice:sandbox suffixe déjà le nom par « — COPIE » ; ceci le rend explicite
# jusque dans l'onglet du navigateur.
ODICE_PRODUCT_NAME=Odice Helpdesk (staging)

# --- Adressage des services ---------------------------------------------------
#
# LE PIÈGE LE PLUS COÛTEUX DE CETTE INSTALLATION, et il ne se voit pas.
#
# Le conteneur nginx du staging appartient à DEUX réseaux : celui du staging, et
# celui de la production — indispensable pour que nginx-proxy l'atteigne. Or les
# deux réseaux contiennent des conteneurs portant les MÊMES alias :
# « zammad-postgresql », « zammad-redis », « zammad-memcached »,
# « zammad-railsserver ». Docker ne garantit aucun ordre de résolution.
#
# Constaté : depuis ce conteneur, « zammad-postgresql » résolvait vers la base de
# PRODUCTION. Rails mourait à l'authentification, sans message — d'où un nginx
# qui ne démarrait jamais et un 502 permanent. Et si les mots de passe avaient
# été identiques, le staging aurait travaillé dans les données de production.
#
# On désigne donc chaque service par son NOM DE CONTENEUR complet, unique sur la
# machine. Ces noms dérivent de COMPOSE_PROJECT_NAME : les revoir si vous le
# changez.
POSTGRES_HOST=zammad-staging-zammad-postgresql-1
MEMCACHE_SERVERS=zammad-staging-zammad-memcached-1:11211
REDIS_URL=redis://zammad-staging-zammad-redis-1:6379
ZAMMAD_RAILSSERVER_HOST=zammad-staging-zammad-railsserver-1
ZAMMAD_WEBSOCKET_HOST=zammad-staging-zammad-websocket-1

# --- Isolation des données ----------------------------------------------------
# Mots de passe DISTINCTS de la production : ils ne protègent de rien s'ils sont
# les mêmes, et le staging est plus exposé.
#
# SANS CARACTÈRE « $ » : Compose y verrait le début d'une variable et
# tronquerait la valeur — « aB3$Ks-9xQ2mZ » arriverait au conteneur en
# « aB3-9xQ2mZ », et cela ne se découvre qu'à la première connexion. Pour en
# générer un sûr :
#
#     tr -dc 'A-Za-z0-9_-' < /dev/urandom | head -c 32; echo
POSTGRES_PASSWORD=
POSTGRESQL_PASS=

# --- Recherche ---------------------------------------------------------------
# Elasticsearch est COUPÉ sur le staging : le serveur ne dispose que de 4 Go
# libres et d'aucun espace d'échange, et un second nœud en réclamerait un à deux
# à lui seul — au détriment direct de la production, qui tourne sur la même
# machine.
#
# Zammad le supporte nativement : l'entrypoint pose alors `es_url` à vide
# (bin/docker-entrypoint:92) et la recherche bascule sur SQL. Aucun service ne
# dépend d'Elasticsearch dans zammad-docker-compose, la désactivation est donc
# sans effet de bord.
#
# CE QUE CELA COÛTE : la recherche du staging n'est plus représentative de celle
# de la production — pas de recherche plein texte dans le corps des articles, ni
# de pertinence. Tout le reste l'est. Une régression de recherche ne se verra
# donc qu'en production ; c'est un compromis assumé, pas un oubli.
ELASTICSEARCH_ENABLED=false
# Conservé pour le jour où la mémoire le permettrait : espace de noms distinct,
# sans quoi les deux instances écriraient dans les mêmes index.
ELASTICSEARCH_NAMESPACE=zammad_staging

# --- Sobriété -----------------------------------------------------------------
# Le staging partage le processeur et la mémoire avec la production.
ODICE_ROLLBACK_DIR=/opt/odice-rollback/staging
# Pas de sauvegarde nocturne : les données du staging sont jetables par
# construction, et deux sauvegardes concurrentes satureraient le disque.
BACKUP_TIME=
HOLD_DAYS=2

# --- Image --------------------------------------------------------------------
IMAGE_REPO=ghcr.io/raphaelherbepin/odice-ticketing
VERSION=odice-main
