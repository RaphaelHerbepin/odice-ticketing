# Modèle — exposition via nginx-proxy + acme-companion.
#
# À copier en `docker-compose.override.yml` dans votre répertoire
# zammad-docker-compose SI vous n'en avez plus, et à ajuster.
#
# nginx-proxy ne route que ce qu'il découvre : il lit VIRTUAL_HOST sur les
# conteneurs qui partagent un réseau avec lui. Sans ces variables, aucun vhost
# n'est généré et le navigateur reçoit ERR_SSL_UNRECOGNIZED_NAME_ALERT — le
# certificat existe peut-être encore, mais plus rien ne répond pour ce nom.
#
# Pour retrouver vos valeurs :
#   docker inspect nginx-proxy --format '{{range $k,$v := .NetworkSettings.Networks}}{{println $k}}{{end}}'
#   docker exec nginx-proxy ls /etc/nginx/certs/

services:
  zammad-nginx:
    environment:
      # Interpolé depuis le .env, et NON écrit en dur : c'est ce qui rend la
      # page de maintenance possible.
      #
      # nginx-proxy répartit les requêtes entre tous les conteneurs déclarant un
      # même VIRTUAL_HOST : en démarrer un second pour la maintenance donnerait
      # une alternance aléatoire entre le site et la page. Détacher celui-ci du
      # réseau ne tient pas davantage — `docker compose up -d` le recrée au
      # milieu du déploiement, avec son vhost retrouvé.
      #
      # Vider ZAMMAD_VIRTUAL_HOST dans le .env retire en revanche l'application
      # des vhosts de façon PERSISTANTE aux recréations de conteneurs. C'est le
      # seul état qui survive à un `up -d`, donc le seul pivot fiable.
      # Voir contrib/odice/switch/maintenance.sh.
      VIRTUAL_HOST: ${ZAMMAD_VIRTUAL_HOST:-}
      # Port INTERNE du conteneur, pas celui publié sur l'hôte.
      VIRTUAL_PORT: 8080
      LETSENCRYPT_HOST: ${LETSENCRYPT_HOST:-}
      LETSENCRYPT_EMAIL: ${LETSENCRYPT_EMAIL:-}
    networks:
      # `default` EST le réseau du projet : Compose le nomme <projet>_default,
      # donc « zammad-docker-compose_default ». Ne l'ajoutez pas une seconde
      # fois sous ce nom complet — il faudrait alors le déclarer en external,
      # et Compose refuse la configuration tant qu'il ne l'est pas.
      - default
      - nginx-proxy

networks:
  # Le réseau sur lequel tourne nginx-proxy, déjà créé : d'où `external`.
  # Le nom doit être EXACTEMENT celui relevé plus haut — souvent
  # « nginx-proxy », parfois « <répertoire>_default » ou « webproxy ».
  # S'il ne correspond pas, Compose échoue avec « network … not found ».
  nginx-proxy:
    external: true
