# Odice — lignes à AJOUTER au `.env` de votre zammad-docker-compose.
#
#   cat contrib/odice/zdc/env.odice.example >> /opt/zammad-docker-compose/.env
#   $EDITOR /opt/zammad-docker-compose/.env
#
# Ne touchez pas aux lignes existantes : IMAGE_REPO et VERSION sont pilotées par
# les scripts de bascule, qui sauvegardent la base au passage.

# ---------- Image Odice ----------
# Publiée par .github/workflows/odice-image.yaml. Préférez le tag horodaté
# (7.2.x-<sha8>) au tag de branche : il correspond exactement à ce qu'affiche
# Administration → Version.
ODICE_IMAGE_REPO=ghcr.io/raphaelherbepin/odice-ticketing
ODICE_IMAGE_TAG=odice-main

# ---------- Retour arrière ----------
# Renseigné automatiquement par use-odice.sh, à partir de l'image en service au
# moment de la bascule. C'est la cible du retour : ne la laissez pas sur un tag
# mouvant comme « latest ».
ODICE_LEGACY_IMAGE_REPO=
ODICE_LEGACY_IMAGE_TAG=

# Où sont écrites les sauvegardes prises avant chaque bascule. Ce sont elles qui
# rendent le retour arrière possible, les migrations Odice n'étant pas
# réversibles. Sauvegardez ce répertoire ailleurs.
ODICE_ROLLBACK_DIR=/opt/odice-rollback

# ---------- Marque ----------
ODICE_PRODUCT_NAME=Odice Helpdesk
ODICE_ORGANIZATION=Groupe Odice
ODICE_LOGO_PATH=/opt/zammad/public/assets/images/logo.svg
ODICE_LOCALE_DEFAULT=fr-fr
ODICE_TIMEZONE_DEFAULT=Europe/Paris
# Coupe les appels sortants vers images.zammad.com, qui écrasent product_logo.
ODICE_DISABLE_IMAGE_BACKEND=true
