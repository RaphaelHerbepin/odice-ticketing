# Odice — configuration du déploiement de production.
# Copier en `.env` et renseigner. Le fichier `.env` est ignoré par git ET par
# Docker (voir .dockerignore) : sans cette exclusion il partirait dans l'image
# poussée au registry, puisque le Dockerfile fait `COPY . .`.

# ---------- Image ----------
ODICE_IMAGE_REPO=odice-ticketing
ODICE_IMAGE_TAG=develop

# ---------- Exposition publique ----------
# https://helpdesk.odice.fr  -> certificat Let's Encrypt automatique
# :80                        -> HTTP nu, pour un essai local
ODICE_SITE_ADDRESS=https://helpdesk.odice.fr
ODICE_ACME_EMAIL=it@odice.fr

# Caddy est derrière le profil `front` : une seule pile peut détenir 80/443.
# C'est la pile de production qui l'active.
COMPOSE_PROFILES=front

# Amont du domaine canonique — LA variable de bascule. La changer puis recréer
# le conteneur Caddy suffit à basculer ou à revenir en arrière, en ~5 secondes :
#   zammad-nginx:8080                   → sert cette pile (Odice)
#   host.docker.internal:<port legacy>  → sert la pile historique
# Utilisez contrib/odice/switch/, qui vérifie l'amont avant de commuter.
ODICE_PROD_UPSTREAM=zammad-nginx:8080

# Domaine de validation, le temps de la bascule. Laisser vide en dehors de
# cette phase, et activer le bloc correspondant :
#   cp docker/caddy/conf.d/10-staging.caddy{.example,}
ODICE_STAGING_SITE_ADDRESS=
ODICE_STAGING_UPSTREAM=host.docker.internal:8081

# Répertoire du docker-compose.yml de la pile historique, sur ce serveur.
# Les scripts de bascule s'en servent pour l'arrêter et la redémarrer.
ODICE_LEGACY_COMPOSE_PATH=/opt/zammad-docker-compose
# Port sur lequel la pile historique publie son nginx, vu depuis l'hôte.
ODICE_LEGACY_UPSTREAM=host.docker.internal:8080

# ---------- PostgreSQL (conteneur) ----------
POSTGRES_DB=zammad_production
POSTGRES_USER=zammad
POSTGRES_PASSWORD=CHANGEZ_MOI

# ---------- PostgreSQL (vu par Zammad) ----------
POSTGRESQL_DB=zammad_production
POSTGRESQL_HOST=zammad-postgresql
POSTGRESQL_PORT=5432
POSTGRESQL_USER=zammad
POSTGRESQL_PASS=CHANGEZ_MOI
POSTGRESQL_OPTIONS=?pool=50
POSTGRESQL_DB_CREATE=true

# ---------- Elasticsearch ----------
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOST=zammad-elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEMA=http
ELASTICSEARCH_NAMESPACE=zammad
ELASTICSEARCH_REINDEX=true

# ---------- Caches ----------
REDIS_URL=redis://zammad-redis:6379
MEMCACHE_SERVERS=zammad-memcached:11211

# ---------- nginx interne ----------
NGINX_PORT=8080
NGINX_SERVER_NAME=helpdesk.odice.fr
# IMPÉRATIF derrière un terminaison TLS : sans « https » ici, nginx transmet
# X-Forwarded-Proto: http et Zammad fabrique des URLs http:// dans TOUS les
# e-mails sortants et les redirections OAuth. Symptôme tardif et déroutant.
NGINX_SERVER_SCHEME=https
NGINX_CLIENT_MAX_BODY_SIZE=50M

# ---------- Rails ----------
# Doit contenir le CIDR du réseau Docker (figé dans docker-compose.yml), et non
# un nom d'hôte : lib/zammad/trusted_proxies.rb ne résout les noms qu'une fois
# au démarrage, or l'IP du conteneur nginx change à chaque redémarrage.
RAILS_TRUSTED_PROXIES=127.0.0.1,::1,172.28.0.0/16
ZAMMAD_FQDN=helpdesk.odice.fr
ZAMMAD_HTTP_TYPE=https

# ---------- Configuration Odice ----------
# Incrémenter pour rejouer le provisionnement après avoir changé une valeur.
ODICE_PROVISION_VERSION=1
ODICE_PRODUCT_NAME=Odice Helpdesk
ODICE_ORGANIZATION=Groupe Odice
ODICE_LOGO_PATH=contrib/odice/brand/out/logo.svg
ODICE_LOCALE_DEFAULT=fr-fr
# Aligne AUSSI les utilisateurs ayant déjà choisi une autre langue.
# Laisser vide pour ne corriger que ceux restés sur la langue d'installation.
ODICE_FORCE_USER_LOCALE=
ODICE_TIMEZONE_DEFAULT=Europe/Paris
# Coupe les appels sortants vers images.zammad.com, qui écrasent product_logo.
ODICE_DISABLE_IMAGE_BACKEND=true
AUTOWIZARD_JSON=

# ---------- Sauvegardes ----------
BACKUP_TIME=03:00
HOLD_DAYS=14
