# Domaine de validation — à activer en retirant le suffixe « .example », le
# temps de la phase de bascule, puis à retirer une fois la bascule faite.
#
#   cp docker/caddy/conf.d/10-staging.caddy{.example,}
#   make front-reload
#
# L'amont pointe vers le nginx de la pile de validation, publié sur la boucle
# locale de l'hôte par docker-compose.staging.yml.

{$ODICE_STAGING_SITE_ADDRESS} {
	import zammad_proxy {$ODICE_STAGING_UPSTREAM}
}
