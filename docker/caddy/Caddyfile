# Odice — terminaison TLS.
#
# Caddy plutôt que Traefik : un seul service HTTP à exposer, quelques lignes de
# configuration, certificats Let's Encrypt automatiques, et surtout aucun accès
# à /var/run/docker.sock — ce qu'on évite pour un conteneur exposé sur Internet.
#
# Une seule pile tourne à la fois, et elle répond toujours sur zammad-nginx :
# l'amont n'a donc pas à varier. Basculer entre la version historique et la
# version Odice revient à changer le tag de l'image, pas la configuration du
# proxy. Voir contrib/odice/BASCULE.md.

{
	email {$ODICE_ACME_EMAIL}
}

{$ODICE_SITE_ADDRESS} {
	encode zstd gzip

	reverse_proxy zammad-nginx:{$NGINX_PORT} {
		# Désactive la mise en tampon : nécessaire au long-polling de /ws
		# (nginx est configuré avec proxy_read_timeout 86400).
		flush_interval -1

		# ActionCable autorise l'origine égale au Host de la requête : ce
		# dernier doit donc traverser le proxy intact.
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
