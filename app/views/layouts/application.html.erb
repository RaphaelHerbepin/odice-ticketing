<!DOCTYPE html>
<html data-odice-version="<%= Version.get %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title><%= Setting.get('product_name') %></title>
  <link rel="apple-touch-icon" href="apple-touch-icon.png" />
  <%= stylesheet_link_tag "application", :media => 'all' %>
  <%= stylesheet_link_tag "application-print", :media => 'print' %>
  <%= javascript_tag nonce: true do -%>
    /* Odice : la racine sert l'ancienne interface. On bascule vers le nouveau
       frontend (desktop ou mobile selon la largeur d'écran) AVANT de charger
       les 4 Mo de JavaScript hérité, pour éviter tout affichage transitoire.

       Ne redirige que la racine SANS fragment : `/#manage`, `/#ticket/zoom/1`,
       etc. continuent de fonctionner, ce qui préserve l'accès à
       l'administration, non encore portée sur le nouveau frontend.
       Échappatoire : `/?legacy=1`, mémorisée ensuite pour la session. */
    try {
      var odiceForceLegacy = window.location.search.indexOf('legacy') !== -1;
      if (odiceForceLegacy) { sessionStorage.setItem('odice_force_legacy', '1'); }

      if (window.location.pathname === '/' &&
          (!window.location.hash || window.location.hash === '#') &&
          sessionStorage.getItem('odice_force_legacy') !== '1') {
        window.location.replace(window.matchMedia('(max-width: 767px)').matches ? '/mobile' : '/desktop');
      }
    } catch (e) { };

    if(window.MSInputMethodContext && document.documentMode){
      var polyfillScriptTag = document.createElement('script');
      polyfillScriptTag.setAttribute('src', '<%= path_to_javascript('ie11CustomProperties.min') %>');
      polyfillScriptTag.setAttribute('nonce', '<%= content_security_policy_nonce %>');
      document.head.appendChild(polyfillScriptTag);
    }

    /* Odice — thème appliqué AVANT le chargement de la session.

       L'amont forçait le sombre dès que le système l'était, sous condition
       d'une clé localStorage `theme` que rien, dans tout le code, n'écrit
       jamais : la condition était donc toujours vraie. L'interface historique
       basculait en sombre même pour un agent ayant choisi le clair, d'où
       l'écart permanent avec le nouveau frontend, qui lit `preferences.theme`.

       Ici : défaut CLAIR, et la préférence réelle — mémorisée par
       odice_theme_sync.coffee après chaque changement — est respectée dès le
       premier rendu, sans clignotement. */
    try {
      var odiceTheme = localStorage.getItem('odice_theme') || 'light';
      if (odiceTheme === 'auto') {
        odiceTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      if (!window.location.href.includes('/tests_')) {
        document.documentElement.dataset.theme = odiceTheme;
        document.documentElement.style.colorScheme = odiceTheme;
      }
    } catch (e) { };
  <% end -%>
  <% if Rails.configuration.assets.debug %>
    <%= javascript_include_tag "application", nonce: true %>
  <% else %>
    <%= javascript_include_tag "application", nonce: true, :defer => 'defer' %>
  <% end %>

  <%# Statically include external files with a nonce here to conform to CSP properly. %>
  <%# Required by form channel configuration preview. %>
  <%= javascript_include_tag "../assets/form/form.js", nonce: true, :defer => 'defer', :skip_pipeline => true, :id => "zammad_form_script"  %>

  <%# Required for browser time mocking in tests. %>
  <% if Rails.env.test? %>
    <%= javascript_include_tag "../assets/tests/sinon-9.2.4.js", nonce: true, :skip_pipeline => true, :id => "zammad_form_script"  %>
  <% end %>

  <%= csrf_meta_tags %>
</head>
<body>

  <%= content_for?(:content) ? yield(:content) : yield %>

</body>
</html>
