<%# Odice — mise en page appliquée à l'envoi par Odice::MailLayout (classe .odice-mail). %>
<% if @objects[:standalone] == true %>
<%= d 'message', false %>
<% else %>
<div class="odice-mail">
<%= d 'message', false %>
<div class="odice-footnote">
  <% if @objects[:reason] %><%= t @objects[:reason] %><br><% end %>
  <a href="<%= c 'http_type' %>://<%= c 'fqdn' %>/#profile/notifications" style="color:#6e7274;text-decoration:underline;"><%= t 'Manage your notification settings' %></a>
</div>
</div>
<% end %>
