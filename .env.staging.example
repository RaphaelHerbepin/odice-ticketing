# Odice — pile de VALIDATION (copie des données, domaine secondaire).
#
#   cp .env.staging.example .env.staging && $EDITOR .env.staging
#   make staging-up
#
# Cette pile a sa propre base : elle ne touche jamais à la production.

# ---------- Image ----------
# Le tag publié par le workflow CI. « odice-main » suit la branche ;
# préférez un tag horodaté (7.2.x-<sha8>) pour une validation reproductible.
ODICE_IMAGE_REPO=ghcr.io/raphaelherbepin/odice-ticketing
ODICE_IMAGE_TAG=odice-main

# ---------- Réseau et exposition ----------
# Port sur la boucle locale de l'hôte ; le Caddy de la pile de production y
# envoie le domaine de validation.
ODICE_STAGING_PORT=8081
# Ne doit chevaucher ni 172.28.0.0/16 (production) ni le réseau de la pile
# historique. Vérifiez avec : docker network inspect <réseau> | grep Subnet
ODICE_STAGING_SUBNET=172.29.0.0/16
ODICE_STAGING_ES_HEAP=512m

# ---------- Zammad ----------
# Le fqdn de CETTE pile. Il détermine les URL fabriquées par Zammad, et surtout
# la redirection OAuth : config/initializers/omniauth.rb construit
# OmniAuth.config.full_host à partir de ce réglage.
ZAMMAD_FQDN=nouveau.odice.fr
ZAMMAD_HTTP_TYPE=https
NGINX_PORT=8080
NGINX_SERVER_NAME=nouveau.odice.fr
NGINX_SERVER_SCHEME=https
# CIDR du réseau ci-dessus. lib/zammad/trusted_proxies.rb ne résout les noms
# d'hôtes qu'une fois au démarrage : une adresse IP changeante casserait la
# détection du client réel. D'où un CIDR, pas un nom.
RAILS_TRUSTED_PROXIES=127.0.0.1,::1,172.29.0.0/16

# ---------- Base de données (PROPRE à cette pile) ----------
POSTGRES_DB=zammad_staging
POSTGRES_USER=zammad
POSTGRES_PASSWORD=CHANGEZ_MOI
POSTGRESQL_DB=zammad_staging
POSTGRESQL_HOST=zammad-postgresql
POSTGRESQL_PORT=5432
POSTGRESQL_USER=zammad
POSTGRESQL_PASS=CHANGEZ_MOI
POSTGRESQL_OPTIONS=?pool=50
POSTGRESQL_DB_CREATE=true

# ---------- Elasticsearch ----------
# Mettez false si la RAM du VPS est juste : avec cette volumétrie, la recherche
# SQL suffit largement pour valider l'ergonomie.
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOST=zammad-elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEMA=http
ELASTICSEARCH_NAMESPACE=zammad
ELASTICSEARCH_REINDEX=true

# ---------- Marque ----------
ODICE_PRODUCT_NAME=Odice Helpdesk
ODICE_ORGANIZATION=Groupe Odice
ODICE_LOGO_PATH=/opt/zammad/public/assets/images/logo.svg
ODICE_DISABLE_IMAGE_BACKEND=1

# ---------- Neutralisation de la copie ----------
# restore-local.sh lance odice:sandbox après la restauration : canaux,
# déclencheurs et automatisations désactivés, pour que la copie n'écrive jamais
# à de vrais clients. Ces trois variables lui disent où elle se trouve.
ODICE_SANDBOX_FQDN=nouveau.odice.fr
# Derrière Caddy, le site est en HTTPS : sans cela les liens seraient en http://
# et le cookie de session perdrait son attribut Secure.
ODICE_SANDBOX_HTTP_TYPE=https
ODICE_SANDBOX_PASSWORD=CHANGEZ_MOI
